# Copie para .env e ajuste os valores. Nunca versione o .env real.
DB_NAME=cuidaidoso
DB_USER=cuida
DB_PASSWORD=troque-esta-senha

# Nome do ambiente mostrado em GET / (local, staging ou production)
APP_AMBIENTE=local
DDL_AUTO=update
APP_PORT=8080

# Usado nos deploys (staging/produção). Local pode ficar assim:
APP_IMAGE=cuidaidoso:local
